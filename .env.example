# JP Court Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Elasticsearch
ES_HOST=http://localhost:9200
ES_API_KEY=your-elasticsearch-api-key-here

# Your case identifier (alphanumeric, hyphens, underscores, 1-64 chars)
CASE_ID=YOUR-CASE-ID

# Index names (change if you use different names)
CASE_INDEX=case_docs_index
STATUTES_INDEX=statutes_index
